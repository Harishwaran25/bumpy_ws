# ── ROS2 Node ──────────────────────────────────────────────────────────────

class WebNode(Node):
    def __init__(self):
        super().__init__('web_interface_node')

        self.bridge = CvBridge()

        # ── Publishers ──
        self.cmd_vel_pub = self.create_publisher(Twist, CMD_VEL_TOPIC, 10)
        self.initial_pose_pub = self.create_publisher(PoseWithCovarianceStamped, '/initialpose', 10)
        
        # ── NEW: Action client for Nav2 (replaces goal_pub) ──
        self.nav_action_client = ActionClient(self, NavigateToPose, 'navigate_to_pose')
        self.get_logger().info('⏳ Waiting for Nav2 action server...')
        if self.nav_action_client.wait_for_server(timeout_sec=5.0):
            self.get_logger().info('✅ Nav2 action server connected!')
        else:
            self.get_logger().warn('⚠️  Nav2 action server not available yet (will retry)')

        # ── Subscribers ──
        self.odom_sub = self.create_subscription(Odometry, '/odom', self.odom_callback, 10)
        self.scan_sub = self.create_subscription(LaserScan, '/scan', self.laser_callback, 10)

        # Camera subscriber — subscribes to CAMERA_TOPIC and keeps the latest JPEG
        self.latest_frame_jpeg: bytes | None = None
        self.camera_receiving: bool = False
        self.camera_enabled: bool = False  # ✨ Camera starts DISABLED by default - toggle to enable
        self._frame_lock = threading.Lock()
        self.camera_sub = self.create_subscription(
            RosImage, CAMERA_TOPIC, self.camera_callback, 1)

        # ── Battery & SLAM confidence subscribers (bumpy7) ──
        self.battery_sub = self.create_subscription(
            Float32, '/battery_percentage', self.battery_callback, 10)
        self.confidence_sub = self.create_subscription(
            Float32, '/confidence', self.confidence_callback, 10)

        # ── bumpy5 subscribers ──
        self.b5_battery_sub = self.create_subscription(
            Float32, '/bumpy5/battery_percentage', self.b5_battery_callback, 10)
        self.b5_confidence_sub = self.create_subscription(
            Float32, '/bumpy5/confidence', self.b5_confidence_callback, 10)

        # ── Leader election subscriber ──
        self.leader_sub = self.create_subscription(
            String, '/leader_election_node', self.leader_callback, 10)

        # ── State ──
        self.robot_pose = {'x': 0.0, 'y': 0.0, 'theta': 0.0}
        self.laser_scan = []
        self.map_metadata = None
        self.navigation_active = False
        self.current_goal_handle = None
        self.battery_percentage = None
        self.slam_confidence = None
        self.current_leader = None
        self.robot_role = 'unknown'
        # bumpy5 state
        self.b5_battery = None
        self.b5_confidence = None

        self.get_logger().info(f'🚀 Web Interface Node started — camera topic: {CAMERA_TOPIC}')

    # ── Camera callback ────────────────────────────────────────────────────
    def camera_callback(self, msg: RosImage):
        """Convert incoming ROS image to JPEG and store it for the MJPEG stream."""
        # ✨ Only process camera if enabled
        if not self.camera_enabled:
            with self._frame_lock:
                self.camera_receiving = False
                self.latest_frame_jpeg = None
            return
        
        try:
            # Support both raw bgr8/rgb8 and compressed-style mono8
            encoding = msg.encoding.lower()
            if encoding in ('rgb8', 'bgr8', 'mono8', '8uc1', '8uc3'):
                frame = self.bridge.imgmsg_to_cv2(msg, desired_encoding='bgr8')
            else:
                # Fall back — try bgr8, if it fails try passthrough
                try:
                    frame = self.bridge.imgmsg_to_cv2(msg, desired_encoding='bgr8')
                except Exception:
                    frame = self.bridge.imgmsg_to_cv2(msg, desired_encoding='passthrough')

            ret, buf = cv2.imencode('.jpg', frame, [cv2.IMWRITE_JPEG_QUALITY, 85])
            if ret:
                with self._frame_lock:
                    self.latest_frame_jpeg = buf.tobytes()
                    self.camera_receiving = True
        except Exception as e:
            self.get_logger().warn(f'Camera frame conversion error: {e}', throttle_duration_sec=5.0)

    def get_latest_jpeg(self):
        """Return latest JPEG frame only if camera is enabled"""
        with self._frame_lock:
            # Return None if camera is disabled
            if not self.camera_enabled:
                return None
            return self.latest_frame_jpeg

    # ── NEW: Navigation using Nav2 action ──────────────────────────────────
    def navigate_to_pose(self, x, y, theta=0):
        """Send navigation goal to Nav2 using action interface"""
        try:
            if not self.nav_action_client.server_is_ready():
                self.get_logger().error('❌ Nav2 action server not available!')
                # Try to reconnect
                if not self.nav_action_client.wait_for_server(timeout_sec=2.0):
                    return False
            
            # Create goal message
            goal_msg = NavigateToPose.Goal()
            goal_msg.pose.header.frame_id = 'map'
            goal_msg.pose.header.stamp = self.get_clock().now().to_msg()
            goal_msg.pose.pose.position.x = float(x)
            goal_msg.pose.pose.position.y = float(y)
            goal_msg.pose.pose.position.z = 0.0
            
            # Convert theta to quaternion
            qz = math.sin(theta / 2.0)
            qw = math.cos(theta / 2.0)
            goal_msg.pose.pose.orientation.z = qz
            goal_msg.pose.pose.orientation.w = qw
            
            self.get_logger().info(f'📍 Sending Nav2 goal: x={x:.2f}, y={y:.2f}, theta={theta:.2f}')
            
            # Send goal asynchronously
            send_goal_future = self.nav_action_client.send_goal_async(
                goal_msg,
                feedback_callback=self.navigation_feedback_callback
            )
            send_goal_future.add_done_callback(self.goal_response_callback)
            
            self.navigation_active = True
            return True
            
        except Exception as e:
            self.get_logger().error(f'Navigation failed: {e}')
            return False

    def goal_response_callback(self, future):
        """Called when Nav2 accepts or rejects the goal"""
        try:
            goal_handle = future.result()
            if not goal_handle.accepted:
                self.get_logger().warning('❌ Goal rejected by Nav2')
                self.navigation_active = False
                return
            
            self.get_logger().info('✅ Goal accepted by Nav2')
            self.current_goal_handle = goal_handle
            
            # Wait for result
            result_future = goal_handle.get_result_async()
            result_future.add_done_callback(self.goal_result_callback)
        except Exception as e:
            self.get_logger().error(f'Goal response error: {e}')
            self.navigation_active = False

    def goal_result_callback(self, future):
        """Called when navigation completes"""
        try:
            result = future.result().result
            self.get_logger().info(f'✅ Navigation completed')
            self.navigation_active = False
            self.current_goal_handle = None
        except Exception as e:
            self.get_logger().error(f'Navigation result error: {e}')
            self.navigation_active = False

    def navigation_feedback_callback(self, feedback_msg):
        """Called periodically during navigation with progress updates"""
        # Can log distance remaining, ETA, etc. if needed
        pass

    def cancel_navigation(self):
        """Cancel the current navigation goal"""
        if self.current_goal_handle is not None:
            self.get_logger().info('🛑 Canceling navigation...')
            try:
                cancel_future = self.current_goal_handle.cancel_goal_async()
                cancel_future.add_done_callback(
                    lambda future: self.get_logger().info('Navigation canceled')
                )
            except Exception as e:
                self.get_logger().error(f'Cancel error: {e}')
        self.publish_cmd_vel(0.0, 0.0)
        self.navigation_active = False
        return True

    # ── Odometry ───────────────────────────────────────────────────────────
    def odom_callback(self, msg):
        self.robot_pose['x'] = msg.pose.pose.position.x
        self.robot_pose['y'] = msg.pose.pose.position.y
        q = msg.pose.pose.orientation
        self.robot_pose['theta'] = math.atan2(
            2*(q.w*q.z + q.x*q.y), 1 - 2*(q.y*q.y + q.z*q.z))

    # ── Laser scan ─────────────────────────────────────────────────────────
    def laser_callback(self, msg):
        self.laser_scan = []
        step = max(1, len(msg.ranges) // 50)
        for i in range(0, len(msg.ranges), step):
            r = msg.ranges[i]
            if r < msg.range_min or r > msg.range_max or not math.isfinite(r):
                continue
            angle = msg.angle_min + i * msg.angle_increment + self.robot_pose['theta']
            self.laser_scan.append({
                'x': self.robot_pose['x'] + r * math.cos(angle),
                'y': self.robot_pose['y'] + r * math.sin(angle)})

    # ── Leader election ────────────────────────────────────────────────────
    def leader_callback(self, msg: String):
        self.current_leader = msg.data.strip()
        self.robot_role = 'leader' if self.current_leader == ROBOT_NAME else 'follower'
        self.get_logger().info(f'👑 Leader: {self.current_leader} → This robot is {self.robot_role}')

    # ── Battery ────────────────────────────────────────────────────────────
    def battery_callback(self, msg: Float32):
        self.battery_percentage = round(float(msg.data), 1)

    # ── SLAM confidence ────────────────────────────────────────────────────
    def confidence_callback(self, msg: Float32):
        self.slam_confidence = round(float(msg.data), 3)

    # ── bumpy5 callbacks ───────────────────────────────────────────────────
    def b5_battery_callback(self, msg: Float32):
        self.b5_battery = round(float(msg.data), 1)

    def b5_confidence_callback(self, msg: Float32):
        self.b5_confidence = round(float(msg.data), 3)

    # ── Velocity ───────────────────────────────────────────────────────────
    def publish_cmd_vel(self, linear, angular):
        msg = Twist()
        msg.linear.x = float(linear)
        msg.angular.z = float(angular)
        self.cmd_vel_pub.publish(msg)


# ── Global node reference ──────────────────────────────────────────────────
web_node: WebNode | None = None


# ── MJPEG stream ───────────────────────────────────────────────────────────

def generate_frames():
    """Yield MJPEG frames sourced from the ROS image subscriber."""
    while True:
        if web_node is None:
            time.sleep(0.05)
            continue
        jpeg = web_node.get_latest_jpeg()
        if jpeg is None:
            # No frame yet — send a small placeholder image
            placeholder = np.zeros((240, 320, 3), dtype=np.uint8)
            cv2.putText(placeholder, 'Waiting for camera topic...', (20, 120),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.55, (150, 150, 150), 1)
            cv2.putText(placeholder, CAMERA_TOPIC, (20, 150),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.45, (100, 200, 100), 1)
            _, buf = cv2.imencode('.jpg', placeholder)
            jpeg = buf.tobytes()
            time.sleep(0.5)   # slow down placeholder frames
        yield (b'--frame\r\nContent-Type: image/jpeg\r\n\r\n' + jpeg + b'\r\n')
        time.sleep(0.033)     # ~30 fps cap


